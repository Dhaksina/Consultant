# ==============================================================
# REVA PHOENIX — Environment Configuration Template
# Copy this file to .env and fill in your real project values.
# ==============================================================

# --------------------------------------------------------------
# 1. FIREBASE AUTHENTICATION & HOSTING (Client-Safe Configuration)
# Obtain these from: Firebase Console -> Project Settings -> General -> Your Apps
# --------------------------------------------------------------
FIREBASE_API_KEY=AIzaSyAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
FIREBASE_AUTH_DOMAIN=reva-phoenix-production.firebaseapp.com
FIREBASE_PROJECT_ID=reva-phoenix-production
FIREBASE_STORAGE_BUCKET=reva-phoenix-production.appspot.com
FIREBASE_MESSAGING_SENDER_ID=123456789012
FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890abcdef

# --------------------------------------------------------------
# 2. SUPABASE MAIN DATABASE (Client-Safe Configuration)
# Obtain these from: Supabase Console -> Project Settings -> API
# --------------------------------------------------------------
# Your Supabase Project URL (HTTPS)
SUPABASE_URL=https://yourprojectref.supabase.co

# Supabase Anon / Publishable Public Key (Safe for frontend use with RLS enabled)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.ey...

# --------------------------------------------------------------
# 3. SERVER-SIDE SECRETS (STRICTLY CONFIDENTIAL — NEVER EXPOSE IN FRONTEND)
# --------------------------------------------------------------
# The Supabase Service Role Key bypasses all Row Level Security.
# It MUST NEVER be placed in frontend code, client bundles, or public repositories.
# Keep this only on trusted backend servers (e.g., Python server.py, Cloud Functions, Edge Functions).
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.ey...
